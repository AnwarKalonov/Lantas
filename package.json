{
  "name": "lantas",
  "private": true,
  "version": "1.4.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Lantas — a desktop coding agent with screen awareness and computer control.",
  "bin": {
    "lantas": "cli/lantas.mjs"
  },
  "scripts": {
    "start": "bash scripts/app-window.sh",
    "app": "open -a Terminal \"$(pwd)/Lantas.command\"",
    "build:mac": "bash scripts/build-mac.sh",
    "cli": "node cli/lantas.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "fflate": "^0.8.3",
    "monaco-editor": "^0.52.2",
    "motion": "^14.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
