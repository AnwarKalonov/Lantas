{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lantas",
  "version": "0.1.0",
  "identifier": "app.lantas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lantas",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "theme": "Dark",
        "backgroundColor": "#0b0b0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A coding agent with screen awareness and computer control",
    "longDescription": "Lantas is a desktop coding agent that reads your workspace, watches your screen, and can act on your computer."
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/AnwarKalonov/Lantas-download/releases/latest/download/latest.json"
      ]
    }
  }
}
