{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lantas",
  "version": "1.8.0",
  "identifier": "app.lantas.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lantas",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "theme": "Dark",
        "backgroundColor": "#0b0b0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A coding agent with screen awareness and computer control",
    "longDescription": "Lantas is a desktop coding agent that reads your workspace, watches your screen, and can act on your computer.",
    "resources": {
      "../chrome-extension/": "chrome-extension/",
      "../cli/": "cli/"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 420 },
        "windowPosition": { "x": 240, "y": 180 },
        "appPosition": { "x": 185, "y": 204 },
        "applicationFolderPosition": { "x": 475, "y": 204 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4RjIwNkZDN0VCRDNGREUKUldUZVA3MSsvQWJ5NkhlR3Z0KzJ6dnRtVkxVa0l4cHVvcmpCalhvcm9LeWZNM0MxdUZFa1VHWFYK",
      "endpoints": [
        "https://github.com/AnwarKalonov/Lantas/releases/latest/download/latest.json"
      ]
    }
  }
}
